# SN74LVC1G3157DCKR — TEXAS INSTRUMENTS
#
# VENDORED PART. Generated by tools/ato-vendor-part.py; the pin map below is
# the part that needs human attention.
#
# Vendored so the build needs no part picker: `has_part_picked` prunes this
# component from the pick tree, so atopile never calls the parts service for it.
# That is what makes an offline build — and therefore any 3D render — possible
# at all on 0.15.x. See docs/hardware/ATOPILE-TOOLCHAIN.md.
#
# SUPPLIER NUMBER IS A PLACEHOLDER. This project sources from TME,
# Digi-Key and Mouser and does not collect LCSC numbers, but the trait
# requires a non-empty one or the `bom` target fails and the 3D targets
# never run. Consequence: atopile's generated BOM is WRONG for this part.
# The real offers are in hardware/bom/snapshot.json — distributor, stock,
# MOQ, price breaks and links. `ato-vendor-part.py --check` lists every
# placeholder so none is mistaken for real data.
#
# PIN MAP: EMPTY AND DELIBERATELY SO. Pin numbers come from the datasheet, and
# generating them from a footprint's pad numbers would produce a plausible,
# unreviewed, wrong netlist — the single most expensive kind of mistake a board
# can carry. Add `signal <NAME> ~ pin <N>` lines below against the datasheet:
#   https://www.ti.com/lit/ds/symlink/sn74lvc1g3157.pdf?ts=1728540283477&ref_url=https%253A%252F%252Fwww.ti.com%252Fproduct%252FSN74LVC1G3157
#
# `footprint`/`symbol`/`model` are filenames relative to THIS directory.
#pragma experiment("TRAITS")
import is_atomic_part
import has_part_picked
import has_designator_prefix
import has_datasheet

component TEXAS_INSTRUMENTS_SN74LVC1G3157DCKR_package:
    trait is_atomic_part<manufacturer="TEXAS INSTRUMENTS", partnumber="SN74LVC1G3157DCKR", footprint="SOT-363_SC-70-6.kicad_mod">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="LCSC-UNKNOWN", manufacturer="TEXAS INSTRUMENTS", partno="SN74LVC1G3157DCKR">
